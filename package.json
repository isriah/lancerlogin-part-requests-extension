{
  "name": "robotics-part-requests",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build",
    "e2e": "node e2e/extension.e2e.mjs",
    "e2e:carts": "node e2e/carts.e2e.mjs",
    "live:carts": "node e2e/carts.live.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.2",
    "jsdom": "^26.1.0",
    "playwright": "1.49.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
